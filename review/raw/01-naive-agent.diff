 // Service builds invoices.
@@ -21,6 +25,59 @@ type Service struct{ repo Repository }
 // New returns a Service backed by repo.
 func New(repo Repository) *Service { return &Service{repo: repo} }
 
+// pricingData is everything the lines of an order need in order to be priced:
+// the product of each line and the tax rule of each line's ship-to region.
+type pricingData struct {
+	products map[int64]store.Product
+	rules    map[string]store.TaxRule
+}
+
+// loadPricingData fetches the products and tax rules referenced by items in
+// two statements, regardless of how many lines the order has.
+func (s *Service) loadPricingData(ctx context.Context, items []store.LineItem) (pricingData, error) {
+	productIDs := make([]int64, 0, len(items))
+	seenProduct := make(map[int64]struct{}, len(items))
+	regions := make([]string, 0, len(items))
+	seenRegion := make(map[string]struct{}, len(items))
+
+	for _, it := range items {
+		if _, ok := seenProduct[it.ProductID]; !ok {
+			seenProduct[it.ProductID] = struct{}{}
+			productIDs = append(productIDs, it.ProductID)
+		}
+		if _, ok := seenRegion[it.Region]; !ok {
+			seenRegion[it.Region] = struct{}{}
+			regions = append(regions, it.Region)
+		}
+	}
+
+	products, err := s.repo.GetProductsByIDs(ctx, productIDs)
+	if err != nil {
+		return pricingData{}, err
+	}
+	rules, err := s.repo.GetTaxRulesForRegions(ctx, regions)
+	if err != nil {
+		return pricingData{}, err
+	}
+	return pricingData{products: products, rules: rules}, nil
+}
+
+// forLine resolves the product and tax rule of one line, reporting a
+// not-found error identical in kind to the one the per-line lookups returned.
+func (d pricingData) forLine(it store.LineItem) (store.Product, store.TaxRule, error) {
+	product, ok := d.products[it.ProductID]
+	if !ok {
+		return store.Product{}, store.TaxRule{},
+			fmt.Errorf("line %d: product %d: %w", it.ID, it.ProductID, store.ErrNotFound)
+	}
+	rule, ok := d.rules[it.Region]
+	if !ok {
+		return store.Product{}, store.TaxRule{},
+			fmt.Errorf("line %d: tax rule %q: %w", it.ID, it.Region, store.ErrNotFound)
+	}
+	return product, rule, nil
+}
